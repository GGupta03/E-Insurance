@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2>Admin Dashboard</h2>

<div class="row">
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Manage Users</h5>
                <p class="card-text">Create, edit, and manage user accounts.</p>
                <a asp-controller="User" asp-action="Index" class="btn btn-primary">Go to Users</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Manage Banks</h5>
                <p class="card-text">Add and manage bank information.</p>
                <a asp-controller="Bank" asp-action="Index" class="btn btn-primary">Go to Banks</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Manage Policies</h5>
                <p class="card-text">Create and manage insurance policies.</p>
                <a asp-controller="Policy" asp-action="ManagePolicies" class="btn btn-primary">Go to Policies</a>
            </div>
        </div>
    </div>
    
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Commission Management</h5>
                <p class="card-text">Calculate and assign agent commissions.</p>
                <a asp-controller="Commission" asp-action="Index" class="btn btn-primary">Go to Commissions</a>
            </div>
        </div>
    </div>
</div>
