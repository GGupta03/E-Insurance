@model E_Insurance_App.Helpers.PaginationHelper<E_Insurance_App.Models.Entities.Bank>

@{
    ViewData["Title"] = "Manage Banks";
}

<h2>Manage Banks</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Bank Name</th>
            <th>IFSC</th>
            <th>Branch</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var bank in Model.Items)
        {
            <tr>
                <td>@bank.BankName</td>
                <td>@bank.IFSC</td>
                <td>@bank.Branch</td>
                <td>@(bank.IsActive ? "Active" : "Inactive")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@bank.BankId"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <form asp-action="ToggleStatus"
                          asp-route-id="@bank.BankId"
                          method="post"
                          style="display:inline;">
                        @Html.AntiForgeryToken()

                        @if (bank.IsActive)
                        {
                            <button type="submit"
                                    class="btn btn-sm btn-danger ms-2"
                                    onclick="return confirm('Deactivate this bank?');">
                                Deactivate
                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    class="btn btn-sm btn-success ms-2"
                                    onclick="return confirm('Activate this bank?');">
                                Activate
                            </button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination -->
<nav>
    <ul class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@i">
                    @i
                </a>
            </li>
        }
    </ul>
</nav>

<a asp-action="Create" class="btn btn-primary">Add New Bank</a>
