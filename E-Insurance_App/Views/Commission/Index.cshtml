@model E_Insurance_App.Models.ViewModels.CommissionViewModel

@{
    ViewData["Title"] = "Commission Management";
}

<h2>Commission Management</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="mb-3">
    <a asp-action="Calculate" class="btn btn-primary">
        + Assign New Commission
    </a>
</div>

<!-- Agents Summary -->
<div class="card mb-4">
    <div class="card-header bg-primary text-white">
        <strong>Agents Commission Summary</strong>
    </div>
    <div class="card-body">
        @if (Model.Agents.Count == 0)
        {
            <div class="alert alert-info mb-0">
                No agents found in the system.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Agent Name</th>
                            <th>Email</th>
                            <th>Policies Sold</th>
                            <th>Total Commission</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var agent in Model.Agents)
                        {
                            <tr>
                                <td>@agent.AgentName</td>
                                <td>@agent.Email</td>
                                <td>
                                    <span class="badge bg-info">@agent.TotalPoliciesSold</span>
                                </td>
                                <td class="text-success fw-bold">
                                    &#8377;@agent.TotalCommission.ToString("N2")
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@agent.AgentId" 
                                       class="btn btn-sm btn-outline-primary">
                                        View Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Recent Commissions -->
<div class="card">
    <div class="card-header bg-secondary text-white">
        <strong>Recent Commission Records</strong>
    </div>
    <div class="card-body">
        @if (Model.Commissions.Count == 0)
        {
            <div class="alert alert-info mb-0">
                No commission records found.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Agent</th>
                            <th>Policy</th>
                            <th>Customer</th>
                            <th>Premium</th>
                            <th>Rate</th>
                            <th>Commission</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comm in Model.Commissions.Take(10))
                        {
                            <tr>
                                <td>@comm.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td>@comm.AgentName</td>
                                <td>@comm.PolicyName</td>
                                <td>@comm.CustomerName</td>
                                <td>&#8377;@(comm.PolicyPremium?.ToString("N2") ?? "0.00")</td>
                                <td>@(comm.CommissionRate?.ToString("N2") ?? "0")%</td>
                                <td class="text-success fw-bold">
                                    &#8377;@(comm.CommissionAmount?.ToString("N2") ?? "0.00")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
