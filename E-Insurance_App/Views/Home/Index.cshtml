@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome to E-Insurance</h1>
    <p class="lead">Your trusted partner for insurance solutions</p>
</div>

<div class="row mt-4">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">View Policies</h5>
                <p class="card-text">Browse available insurance policies and find the right coverage for you.</p>
                <a asp-controller="Policy" asp-action="Available" class="btn btn-primary">View Policies</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Calculate Premium</h5>
                <p class="card-text">Calculate your premium based on your age and policy preferences.</p>
                <a asp-controller="Premium" asp-action="Calculate" class="btn btn-primary">Calculate</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">My Account</h5>
                <p class="card-text">Manage your policies, payments, and account settings.</p>
                <a asp-controller="Home" asp-action="Profile" class="btn btn-primary">My Profile</a>
            </div>
        </div>
    </div>
</div>
