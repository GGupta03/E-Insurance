@model List<E_Insurance_App.Models.Entities.PolicyType>

<h2>Available Insurance Policies</h2>

<table class="table table-bordered">
    <tr>
        <th>Name</th>
        <th>Category</th>
        <th>Premium</th>
        <th>Interest</th>
        <th>Age Range</th>
        <th>Term</th>
        <th></th>
    </tr>

    @foreach (var p in Model)
    {
        <tr>
            <td>@p.PolicyName</td>
            <td>@p.PolicyCategory</td>
            <td>@p.BasePremium</td>
            <td>@p.InterestRate %</td>
            <td>@p.MinAge - @p.MaxAge</td>
            <td>@p.TermYears yrs</td>

            <td>
                <a asp-action="Purchase"
                   asp-route-id="@p.PolicyTypeId"
                   class="btn btn-success btn-sm">
                    Purchase
                </a>
            </td>
        </tr>
    }
</table>
