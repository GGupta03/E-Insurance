@model System.Data.DataTable

@{
    ViewData["Title"] = "My Policies";
}

<h2>My Policies</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (Model.Rows.Count == 0)
{
    <div class="alert alert-info">
        <p>You don't have any policies yet.</p>
        <a asp-action="Available" class="btn btn-primary">Browse Available Policies</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Policy</th>
                    <th>Start Date</th>
                    <th>End Date</th>
                    <th>Premium</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (System.Data.DataRow row in Model.Rows)
                {
                    <tr>
                        <td>@row["PolicyName"]</td>
                        <td>@Convert.ToDateTime(row["StartDate"]).ToString("dd MMM yyyy")</td>
                        <td>@Convert.ToDateTime(row["EndDate"]).ToString("dd MMM yyyy")</td>
                        <td>&#8377;@Convert.ToDecimal(row["PremiumAmount"]).ToString("N2")</td>
                        <td>
                            @{
                                var status = row["PolicyStatus"].ToString();
                            }
                            @if (status == "Active")
                            {
                                <span class="badge bg-success">@status</span>
                            }
                            else if (status == "Expired")
                            {
                                <span class="badge bg-secondary">@status</span>
                            }
                            else
                            {
                                <span class="badge bg-warning">@status</span>
                            }
                        </td>
                        <td>
                            <a asp-controller="Payment" asp-action="MakePayment" 
                               asp-route-id="@row["CustomerPolicyId"]" 
                               class="btn btn-sm btn-primary">
                                Pay Now
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="mt-3">
    <a asp-controller="Payment" asp-action="Index" class="btn btn-outline-secondary">
        View Payment History
    </a>
    <a asp-action="Available" class="btn btn-outline-primary">
        Browse More Policies
    </a>
</div>
