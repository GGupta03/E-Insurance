@model E_Insurance_App.Models.Entities.PolicyType

@{
    ViewData["Title"] = "Purchase Policy";
}

<h2>Confirm Policy Purchase</h2>

<div class="card p-3 shadow-sm">

    <h4>@Model.PolicyName</h4>

    <p>
        <strong>Category:</strong> @Model.PolicyCategory <br />
        <strong>Premium:</strong> ₹@Model.BasePremium <br />
        <strong>Term:</strong> @Model.TermYears years
    </p>

    <form asp-action="PurchaseConfirm" method="post">

        <input type="hidden" name="id" value="@Model.PolicyTypeId" />

        <button class="btn btn-success">
            Confirm Purchase
        </button>

        <a asp-action="Available"
           class="btn btn-secondary">
            Cancel
        </a>

    </form>

</div>
