@model E_Insurance_App.Models.ViewModels.PremiumViewModel

@{
    ViewData["Title"] = "Premium Calculator";
}

<h2>Premium Calculator</h2>
<p class="text-muted">Calculate your estimated premium based on policy and age.</p>

<div class="row">
    <div class="col-md-6">
        <form asp-controller="Premium" asp-action="Calculate" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="PolicyTypeId" class="form-label">Select Policy</label>
                <select asp-for="PolicyTypeId" class="form-select">
                    <option value="0">-- Select Policy --</option>
                    @if (Model.Policies != null)
                    {
                        @foreach (var p in Model.Policies)
                        {
                            <option value="@p.PolicyTypeId">
                                @p.PolicyName (@p.PolicyCategory) - Base: &#8377;@p.BasePremium
                            </option>
                        }
                    }
                </select>
                <span asp-validation-for="PolicyTypeId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Age" class="form-label">Your Age</label>
                <input asp-for="Age" class="form-control" type="number" min="18" max="100" placeholder="Enter your age" />
                <span asp-validation-for="Age" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                Calculate Premium
            </button>
        </form>
    </div>

    <div class="col-md-6">
        @if (Model.Result > 0)
        {
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <strong>Premium Calculation Result</strong>
                </div>
                <div class="card-body">
                    <h5 class="card-title">@Model.SelectedPolicyName</h5>
                    <p class="card-text">
                        Based on your age of <strong>@Model.Age years</strong>, 
                        your estimated annual premium is:
                    </p>
                    <h2 class="text-success">&#8377;@Model.Result.ToString("N2")</h2>
                </div>
            </div>
        }
        else if (Model.Policies == null || Model.Policies.Count == 0)
        {
            <div class="alert alert-warning">
                No active policies available. Please contact the administrator.
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
