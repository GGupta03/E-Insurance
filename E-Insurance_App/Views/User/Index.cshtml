@model E_Insurance_App.Helpers.PaginationHelper<E_Insurance_App.Models.Entities.User>

@{
    ViewData["Title"] = "Manage Users";
}

<h2>Manage Users</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model.Items)
        {
            <tr>
                <td>@user.FirstName @user.LastName</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>@(user.IsActive ? "Active" : "Inactive")</td>
                <td>
                    <a asp-action="Edit"
                       asp-route-id="@user.UserId"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <form asp-action="ToggleStatus"
                          asp-route-id="@user.UserId"
                          method="post"
                          style="display:inline;">
                        @Html.AntiForgeryToken()

                        @if (user.IsActive)
                        {
                            <button type="submit"
                                    class="btn btn-sm btn-danger ms-2">
                                Deactivate
                            </button>
                        }
                        else
                        {
                            <button type="submit"
                                    class="btn btn-sm btn-success ms-2">
                                Activate
                            </button>
                        }
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Pagination Controls -->
<nav>
    <ul class="pagination">
        @for (int i = 1; i <= Model.TotalPages; i++)
        {
            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                <a class="page-link"
                   asp-action="Index"
                   asp-route-page="@i">
                    @i
                </a>
            </li>
        }
    </ul>
</nav>

<a asp-action="Create" class="btn btn-primary">Create New User</a>
